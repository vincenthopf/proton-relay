# Shared configuration for all Proton Relay instances
# Copy to shared.env and fill in your values

# ============================================
# DESTINATION SMTP (where emails get forwarded TO)
# ============================================
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Email address to forward all emails to
FORWARD_TO=

# ============================================
# TELEGRAM ALERTS (optional but recommended)
# ============================================
# Create a bot via @BotFather, get the token
# Get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================
# OPTIONAL SETTINGS
# ============================================
LOG_LEVEL=INFO
MAX_EMAILS_PER_BATCH=10
MARK_AS_READ=true
DELETE_AFTER_FORWARD=false
