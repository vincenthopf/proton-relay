# === Required ===
PROTONMAIL_USERNAME=your-email@protonmail.com
PROTONMAIL_PASSWORD=your-protonmail-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username@gmail.com
SMTP_PASSWORD=your-smtp-app-password

FORWARD_TO=destination@example.com

# === Optional (defaults shown) ===
# BRIDGE_PASSWORD=              # Auto-generated on first run
# FORWARD_FROM=                 # Defaults to SMTP_USERNAME
# CHECK_INTERVAL=30             # Seconds between checks
# LOG_LEVEL=INFO                # DEBUG, INFO, WARNING, ERROR
# HEALTH_CHECK_PORT=8080

# === Telegram Alerts (optional) ===
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# === Migration (one-shot, run with: docker compose --profile migration run --rm migrate) ===
# FASTMAIL_USERNAME=
# FASTMAIL_PASSWORD=
